# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_SINGLE=price_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_STUDIO=price_xxx

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...  # Public anon key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...  # Secret key (never expose to client!)

# Security
CREDIT_WEBHOOK_SECRET=generate_a_secure_random_string_here_32_chars_minimum

# Modal endpoints are not read from here: set the URLs printed by `modal deploy`
# directly in index.html (see docs/SETUP.md, Step 7).
# Gated models need a Modal secret instead: modal secret create huggingface HF_TOKEN=hf_...

# Optional: Analytics and Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxx
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: Email notifications
# SENDGRID_API_KEY=SG.xxx
# NOTIFICATION_EMAIL=notifications@yourdomain.com
